# ---------- 构建输出 ----------
# target/ 是 Maven 每次构建自动生成的产物，体积大且可再生，不应纳入版本管理。
# 忽略它的另一个好处：IDEA 不会把编译产物编入索引，打开项目更快。
target/

# ---------- IDE 配置 ----------
# .idea/ 与 *.iml 记录的是本机的模块、SDK 路径等个人设置，
# 换一台机器就失效，提交上去只会给协作者带来冲突。
.idea/
*.iml
*.ipr
*.iws
.vscode/

# ---------- 日志 ----------
*.log
logs/

# ---------- 操作系统文件 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 本地私有配置 ----------
# 若把真实数据库密码写在本地覆盖配置里，请不要提交
src/main/resources/application-local.yml
application-local.yml
