<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cafe.mapper.MemberMapper">

    <!--
      会员信息统一联表 member_level 带出等级名称与等级折扣。
      档位名称与折扣均可在后台配置，因此绝不写死在 Java 代码里。
    -->
    <sql id="memberColumns">
        m.id, m.card_no, m.name, m.id_card, m.phone, m.password,
        m.balance, m.deposit, m.level, m.status, m.create_time,
        l.level_name,
        l.discount AS level_discount
    </sql>

    <sql id="memberJoin">
        FROM member m
        LEFT JOIN member_level l ON l.level = m.level
    </sql>

    <select id="selectDetailPage" resultType="com.cafe.entity.Member">
        SELECT <include refid="memberColumns"/>
        <include refid="memberJoin"/>
        <where>
            <if test="status != null">AND m.status = #{status}</if>
            <if test="keyword != null and keyword != ''">
                AND (m.name LIKE CONCAT('%', #{keyword}, '%')
                     OR m.card_no LIKE CONCAT('%', #{keyword}, '%')
                     OR m.phone LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
        ORDER BY m.id DESC
    </select>

    <select id="selectWithLevelById" resultType="com.cafe.entity.Member">
        SELECT <include refid="memberColumns"/>
        <include refid="memberJoin"/>
        WHERE m.id = #{id}
    </select>

    <select id="selectByPhone" resultType="com.cafe.entity.Member">
        SELECT <include refid="memberColumns"/>
        <include refid="memberJoin"/>
        WHERE m.phone = #{phone}
    </select>

    <select id="selectByCardNo" resultType="com.cafe.entity.Member">
        SELECT <include refid="memberColumns"/>
        <include refid="memberJoin"/>
        WHERE m.card_no = #{cardNo}
    </select>

</mapper>
